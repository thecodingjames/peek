{
  "name": "peek",
  "version": "1.5.4",
  "description": "A minimal GUI HTTP client",
  "keywords": [
    "gui",
    "http client",
    "electronjs",
    "vuejs",
    "vuetify"
  ],
  "desktopName": "ca.codingjames.peek",
  "productName": "Peek",
  "build": {
    "appId": "ca.codingjames.peek",
    "asar": true,
    "publish": null,
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable"
      ]
    },
    "linux": {
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "maintainer": "James Hoffman <james@jhoffman.ca>",
      "target": [
        "AppImage",
        "tar.gz",
        "deb"
      ]
    },
    "snapcraft": {
      "base": "core24",
      "core24": {
        "confinement": "classic",
        "extensions": []
      }
    }
  },
  "homepage": "https://github.com/thecodingjames/peek#readme",
  "bugs": {
    "url": "https://github.com/thecodingjames/peek/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecodingjames/peek.git"
  },
  "license": "MIT",
  "author": "James Hoffman",
  "type": "commonjs",
  "main": "src/main.js",
  "scripts": {
    "dev": "npx electron .",
    "build": "electron-builder build -lw"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
